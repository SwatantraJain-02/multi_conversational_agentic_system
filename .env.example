
# Database configuration (Aiven Postgres: Service overview -> Connection information)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_SSLMODE=require
POSTGRES_ADMIN_USER=avnadmin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_ADMIN_DB=defaultdb
# Passwords for the two roles scripts/init_db.py creates (choose them yourself)
AGENT_APP_PASSWORD=
AGENT_READONLY_PASSWORD=
MAX_ROWS=100

# Vector database configuration (Pinecone; the index is created on first use)
PINECONE_API_KEY=
PINECONE_INDEX=capstone
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Model / LLM configuration (OpenRouter)
OPENROUTER_API_KEY=
CHAT_MODEL=
JUDGE_MODEL=
EMBED_MODEL=nvidia/nemotron-3.5-embed-8b:free
EMBED_QUERY_PREFIX="query: "
EMBED_DOC_PREFIX="passage: "
EMBED_BATCH_SIZE=1
TEMPERATURE=0
MODEL_REASONING=False

# Langfuse Cloud (Project settings -> API keys); EU https://cloud.langfuse.com, US https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
PROMPT_LABEL=production

# MCP configuration
DB_MCP_HOST=localhost
DB_MCP_PORT=5555
DB_MCP_TOKEN=

# Web search
TAVILY_API_KEY=
