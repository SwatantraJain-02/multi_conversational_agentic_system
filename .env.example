# Copy to .env and fill in the blanks. Each block says which process reads it.
# Variables with a value here are optional; the value shown is the default.

# ---------------------------------------------------------------- Postgres
# docker compose + scripts/init_db.sh only (never read by the Python app)
POSTGRES_ADMIN_PASSWORD=
AGENT_APP_PASSWORD=
# DB MCP server (read-only Northwind connection)
AGENT_READONLY_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
NORTHWIND_DB=northwind
NORTHWIND_READONLY_USER=agent_readonly
MAX_ROWS=100
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_OPEN_TIMEOUT_S=10
DB_POOL_CHECKOUT_TIMEOUT_S=30
DB_CONNECT_TIMEOUT_S=5

# ---------------------------------------------------------------- Chroma
# DB MCP server, scripts/build_schema_index.py
CHROMADB_HOST=localhost
CHROMADB_PORT=5430
CHROMA_TIMEOUT_S=10

# ---------------------------------------------------------------- Embeddings (Ollama)
# DB MCP server, scripts/build_schema_index.py
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Task prefixes nomic-embed-text was trained with; set both empty for other models.
EMBED_DOC_PREFIX="search_document: "
EMBED_QUERY_PREFIX="search_query: "
OLLAMA_TIMEOUT_S=30
EMBED_MAX_RETRIES=2

# ---------------------------------------------------------------- Chat model
# Agent app, scripts/smoke_llm.py. CHAT_PROVIDER is openrouter or ollama.
CHAT_PROVIDER=openrouter
CHAT_MODEL=
OPENROUTER_API_KEY=
TEMPERATURE=0
CHAT_MAX_RETRIES=4

# ---------------------------------------------------------------- DB MCP server
DB_MCP_HOST=localhost
DB_MCP_PORT=5555
# Required unless DB_MCP_HOST is a loopback address.
DB_MCP_TOKEN=
MCP_MAX_SQL_CHARS=5000
MCP_MAX_QUESTION_CHARS=500
MCP_MAX_K=10

# ---------------------------------------------------------------- Observability
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=northwind-db-mcp
# Send traces to an OTLP/HTTP collector, e.g. http://localhost:4318 (Jaeger profile in compose).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
